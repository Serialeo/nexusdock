NEXUS_HOST=127.0.0.1
NEXUS_PORT=18777
NEXUS_PUBLIC_URL=
NEXUS_DATA_DIR=./nexus-data
NEXUS_AUTH_TOKEN=
NEXUS_REQUIRE_AUTH=false
NEXUS_AUTH_ALLOW_INSECURE_HTTP=false
NEXUS_TRUSTED_PROXIES=127.0.0.1,::1
NEXUS_LOG_LEVEL=info

# 生产 Compose 默认使用 Serialeo 私有 GHCR；可固定到已发布版本或 digest。
# NEXUS_IMAGE=ghcr.io/serialeo/nexusdock:latest

# 仅源码 Docker build / docker-compose.dev.yml 需要。不要写入版本库。
# PRIVATE_GO_READ_TOKEN=

RECALL_REPO_DIR=./recall
